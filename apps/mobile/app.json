{
  "expo": {
    "name": "Finanças do Casal",
    "slug": "financas-casal",
    "scheme": "financascasal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.financascasal.app"
    },
    "android": {
      "package": "br.com.financascasal.app",
      "adaptiveIcon": {
        "backgroundColor": "#0d3880",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2a78d6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para anexar a nota fiscal ao lançamento.",
          "cameraPermission": "Para fotografar a nota fiscal."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f5f5f2",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#121211"
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "br.com.financascasal.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.br.com.financascasal.app",
          "widgets": [
            {
              "name": "PrevistoWidget",
              "displayName": "Previsto do mês",
              "description": "Previsto do mês, próximo gasto futuro e atalho para lançar.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PrevistoWidget",
              "label": "Previsto do mês",
              "description": "Previsto do mês, próximo gasto futuro e atalho para lançar.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ]
    ],
    "description": "Controle financeiro do casal: importa a fatura do cartão em PDF, confere os totais e mostra para onde o dinheiro vai.",
    "primaryColor": "#1c68c4"
  }
}
